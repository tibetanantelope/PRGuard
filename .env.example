# Set this to switch PRGuard Job persistence from files to MySQL.
PRGUARD_MYSQL_PASSWORD=prguard_dev_password
PRGUARD_MYSQL_ROOT_PASSWORD=123456
PR_GUARD_MYSQL_URL=mysql://prguard:prguard_dev_password@127.0.0.1:3306/prguard

# PostgreSQL + pgvector-backed long-term memory. PostgreSQL is installed
# separately in WSL for local development; MySQL remains the business store.
PR_GUARD_POSTGRES_URL=postgresql://prguard:prguard_dev_password@127.0.0.1:5432/prguard
PR_GUARD_MEMORY_BACKEND=postgres
PR_GUARD_EMBEDDING_DIMENSIONS=1536
PR_GUARD_EMBEDDING_PROVIDER=remote
PR_GUARD_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
PR_GUARD_EMBEDDING_API_KEY=replace-with-your-bailian-key
PR_GUARD_EMBEDDING_MODEL=text-embedding-v4
PR_GUARD_MEMORY_RETRY_INTERVAL_MS=30000

# Redis Streams is used by the asynchronous Worker.
PR_GUARD_REDIS_URL=redis://127.0.0.1:6379
PR_GUARD_REDIS_RECLAIM_IDLE_MS=30000
PR_GUARD_WORKER_METRICS_PORT=9091
PR_GUARD_MAX_ATTEMPTS=3
PR_GUARD_REVIEW_TIMEOUT_MS=120000
PR_GUARD_MAX_SPECIALISTS=3
PR_GUARD_ORCHESTRATION_MAX_MODEL_CALLS=74
PR_GUARD_ORCHESTRATION_MAX_INPUT_TOKENS=300000
PR_GUARD_ORCHESTRATION_MAX_OUTPUT_TOKENS=50000
PR_GUARD_ORCHESTRATION_MAX_DURATION_MS=360000
PR_GUARD_ORCHESTRATION_MAX_CONCURRENT_AGENTS=3
PR_GUARD_CRITIC_JUDGE_ENABLED=true
PR_GUARD_VERIFICATION_TIMEOUT_MS=120000
# Production-safe verification. Use local only for trusted development repositories.
PR_GUARD_SANDBOX_MODE=docker
PR_GUARD_SANDBOX_IMAGE=node:22-alpine
PR_GUARD_SANDBOX_MEMORY_MB=512
PR_GUARD_SANDBOX_CPUS=1
PR_GUARD_SANDBOX_PIDS_LIMIT=128
PR_GUARD_SANDBOX_MAX_OUTPUT_BYTES=1048576
PR_GUARD_PATCH_MAX_BYTES=1048576
PR_GUARD_PATCH_MAX_FILES=100

# GitHub PR integration. Webhook handling requires the shared secret.
GITHUB_TOKEN=
PR_GUARD_GITHUB_WEBHOOK_SECRET=
PR_GUARD_GITHUB_WORKSPACE=
PR_GUARD_GITHUB_FEEDBACK_ENABLED=false

# When configured, protect internal API endpoints with Authorization: Bearer <key>.
PR_GUARD_API_KEY=
# JSON array: [{"subject":"alice","token":"...","roles":["reviewer"],"projectIds":["project-..."]}]
PR_GUARD_RBAC_JSON=
PR_GUARD_RATE_LIMIT_PER_MINUTE=120
