# Set this to switch PRGuard Job persistence from files to MySQL.
PR_GUARD_MYSQL_URL=mysql://prguard:prguard_dev_password@127.0.0.1:3306/prguard

# Redis will be used by the async Worker in the next batch.
PR_GUARD_REDIS_URL=redis://127.0.0.1:6379
PR_GUARD_MAX_ATTEMPTS=3
PR_GUARD_REVIEW_TIMEOUT_MS=120000

# GitHub PR integration. Webhook handling requires the shared secret.
GITHUB_TOKEN=
PR_GUARD_GITHUB_WEBHOOK_SECRET=
PR_GUARD_GITHUB_WORKSPACE=

# When configured, protect internal API endpoints with Authorization: Bearer <key>.
PR_GUARD_API_KEY=
PR_GUARD_RATE_LIMIT_PER_MINUTE=120
